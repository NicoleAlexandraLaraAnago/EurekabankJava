<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Etiqueta accesible opcional -->
    <TextView
        android:id="@+id/label_cuenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Número de cuenta"
        android:textColor="#000000"
        android:textStyle="bold"
        android:labelFor="@id/et_cuenta" />

    <!-- Campo de texto corregido sin contentDescription -->
    <EditText
        android:id="@+id/et_cuenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese número de cuenta"
        android:inputType="number"
        android:textColor="#000000"
        android:padding="12dp"
        android:importantForAccessibility="yes"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Botón accesible -->
    <Button
        android:id="@+id/btn_consultar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consultar Movimientos"
        android:layout_marginTop="8dp"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:contentDescription="Consultar movimientos de la cuenta ingresada" />

    <!-- Lista de resultados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_movimientos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#EEEEEE"
        android:contentDescription="Lista de movimientos" />

</LinearLayout>
