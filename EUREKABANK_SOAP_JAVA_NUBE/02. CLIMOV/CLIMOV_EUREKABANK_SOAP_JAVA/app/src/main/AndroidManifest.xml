<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.climov_eurekabank_soap_java">

    <!-- Permiso para conexiones HTTP/HTTPS -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CLIMOV_EUREKABANK_SOAP_JAVA"
        tools:targetApi="31">

        <!-- Nueva pantalla que muestra los movimientos como tabla -->
        <activity
            android:name="modelo.MovimientoTabla"
            android:exported="false" />

        <!-- Actividad de detalle de movimientos (si la usas para registrar o ver uno solo) -->
        <activity
            android:name="modelo.MovimientoActivity"
            android:exported="false" />

        <!-- Pantalla de depósitos -->
        <activity
            android:name="modelo.Depositos"
            android:exported="false" />

        <!-- Menú principal -->
        <activity
            android:name="modelo.Menu"
            android:exported="false" />

        <!-- Pantalla de login -->
        <activity
            android:name="modelo.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
